# Réglages de l'automatisation. Pour l'essayer sur un ordinateur : copiez ce fichier en .env et remplissez les lignes.
# Sur GitHub, ces valeurs vont dans Settings → Secrets and variables → Actions (Kekeli les y met pour vous).
# Ne mettez jamais ces valeurs dans le code ni sur GitHub en clair.

# Votre modèle d'intelligence artificielle (adresse compatible OpenAI, voir le LISEZ-MOI).
MODELE_API_URL=
MODELE_API_CLE=
MODELE_NOM=

# E-mail : clé Resend (offre gratuite : 100 e-mails par jour), destinataire et expéditeur.
RESEND_API_KEY=
EMAIL_DESTINATAIRE=
# Sans domaine vérifié chez Resend : laissez vide (onboarding@resend.dev, qui n'écrit qu'à l'adresse de votre compte Resend).
EMAIL_EXPEDITEUR=
