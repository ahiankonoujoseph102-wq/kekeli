# Réglages de l'agent. Copiez ce fichier en .env et remplissez les lignes vides.
# Ne mettez jamais ces valeurs dans le code ni sur GitHub.

# Adresse de l'interface de votre modèle (compatible OpenAI).
# OpenAI : https://api.openai.com/v1
# Gemini : https://generativelanguage.googleapis.com/v1beta/openai
MODELE_API_URL=https://api.openai.com/v1
# Votre clé chez ce fournisseur (créée sur son site). Elle reste sur le serveur.
MODELE_API_CLE=
# Le nom du modèle chez votre fournisseur (voir la liste des modèles sur son site).
MODELE_NOM=

# Port du serveur de l'agent.
PORT=3000
# Messages permis par minute pour une même personne.
LIMITE_MESSAGES_MINUTE=10
# Sites qui peuvent afficher la bulle (adresses séparées par des virgules). Vide : tous les sites.
ORIGINES_AUTORISEES=

# Facultatif : clé Tavily pour que l'agent puisse chercher sur Internet.
TAVILY_API_KEY=
