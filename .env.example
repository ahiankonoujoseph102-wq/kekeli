APP_NAME=Kekeli
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="bonjour@kekeli.dev"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Kekeli : Runner et fournisseurs d'IA (jamais de vraie valeur dans ce fichier)
KEKELI_RUNNER_URL=http://127.0.0.1:3100
KEKELI_RUNNER_SECRET=
KEKELI_FOURNISSEURS=gemini,gemini/gemini-3.1-flash-lite,openrouter,openrouter/cohere/north-mini-code:free,workersai,mistral
# KEKELI_MODELE_GEMINI=gemini-3.5-flash-lite
# KEKELI_MODELE_GROQ=openai/gpt-oss-120b
# KEKELI_MODELE_OPENROUTER=nvidia/nemotron-3-ultra-550b-a55b:free
# KEKELI_MODELE_MISTRAL=devstral-latest
# KEKELI_LIMITE_JOUR_GEMINI=500
# KEKELI_LIMITE_JOUR_GROQ=1000
# KEKELI_LIMITE_JOUR_OPENROUTER=50

# Domaines acceptés pour les liens d’aperçu en direct (ordinateurs virtuels E2B)
KEKELI_DOMAINES_APERCU=e2b.app,e2b.dev

# Disque des sauvegardes, photos et captures de paiement (« s3 » sur Laravel Cloud, avec un bucket rattaché)
KEKELI_DISQUE_SAUVEGARDES=local
# Pays « bientôt disponibles » pendant la bêta (liste dans config/kekeli.php) ; « aucun » pour tout ouvrir
# KEKELI_PAYS_BIENTOT=aucun

# Envoi du code des clients vers GitHub (application OAuth de Kekeli, gratuite)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Lecture du coût de Kekeli sur Laravel Cloud (clé avec la seule permission de lire l'usage), et seuil dans l'administration
LARAVEL_CLOUD_API_TOKEN=
# Noms de Kekeli dans Laravel Cloud (jamais ceux des autres sites)
# KEKELI_CLOUD_APPLICATIONS=kekeli,kekeli-runner
# KEKELI_CLOUD_BASES=kekeli
# Adresse de l'interface de GitHub (à ne changer que pour un essai local, voir scripts/essai-relais-github.mjs)
# KEKELI_GITHUB_API=https://api.github.com
